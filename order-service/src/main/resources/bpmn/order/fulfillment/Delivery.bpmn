<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_deliveryprocess" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="DeliveryProcess" name="Delivery" isExecutable="true">
      <bpmn:startEvent id="StartDelivery" name="Delivery started">
        <bpmn:outgoing>Flow_d1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="FindItems" name="Find the items" camunda:type="external" camunda:topic="findItems">
        <bpmn:documentation>Looks the positions up in the order storage. Falls back to the catalog when the order carries item codes only.</bpmn:documentation>
        <bpmn:incoming>Flow_d1</bpmn:incoming>
        <bpmn:outgoing>Flow_d2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="FindItemsInCatalog" name="Find the items in the catalog" camunda:type="external" camunda:topic="findItemsInCatalog">
        <bpmn:incoming>Flow_d2</bpmn:incoming>
        <bpmn:outgoing>Flow_d3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="PickCourier" name="Pick a courier (auto)" camunda:assignee="${logisticsUser}" camunda:candidateGroups="logistics">
        <bpmn:incoming>Flow_d3</bpmn:incoming>
        <bpmn:outgoing>Flow_d4</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="CourierTimeout" name="No courier in 2 days" attachedToRef="PickCourier" cancelActivity="true">
        <bpmn:timerEventDefinition id="TimerDef_1">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
        <bpmn:outgoing>Flow_d5</bpmn:outgoing>
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="EscalateDelivery" name="Escalate the delivery" camunda:type="external" camunda:topic="escalateDelivery">
        <bpmn:incoming>Flow_d5</bpmn:incoming>
        <bpmn:outgoing>Flow_d6</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="DeliveryDone" name="Delivered">
        <bpmn:incoming>Flow_d4</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="DeliveryFailed" name="Delivery failed">
        <bpmn:incoming>Flow_d6</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_d1" sourceRef="StartDelivery" targetRef="FindItems" />
      <bpmn:sequenceFlow id="Flow_d2" sourceRef="FindItems" targetRef="FindItemsInCatalog" />
      <bpmn:sequenceFlow id="Flow_d3" sourceRef="FindItemsInCatalog" targetRef="PickCourier" />
      <bpmn:sequenceFlow id="Flow_d4" sourceRef="PickCourier" targetRef="DeliveryDone" />
      <bpmn:sequenceFlow id="Flow_d5" sourceRef="CourierTimeout" targetRef="EscalateDelivery" />
      <bpmn:sequenceFlow id="Flow_d6" sourceRef="EscalateDelivery" targetRef="DeliveryFailed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="DeliveryProcess">
      <bpmndi:BPMNShape id="StartDelivery_di" bpmnElement="StartDelivery"><dc:Bounds x="142" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="124" y="143" width="96" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FindItems_di" bpmnElement="FindItems"><dc:Bounds x="285" y="80" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FindItemsInCatalog_di" bpmnElement="FindItemsInCatalog"><dc:Bounds x="465" y="80" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PickCourier_di" bpmnElement="PickCourier"><dc:Bounds x="645" y="80" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CourierTimeout_di" bpmnElement="CourierTimeout"><dc:Bounds x="682" y="252" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="664" y="293" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EscalateDelivery_di" bpmnElement="EscalateDelivery"><dc:Bounds x="825" y="230" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DeliveryDone_di" bpmnElement="DeliveryDone"><dc:Bounds x="862" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="844" y="143" width="60" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DeliveryFailed_di" bpmnElement="DeliveryFailed"><dc:Bounds x="1042" y="252" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1024" y="293" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_d1_di" bpmnElement="Flow_d1"><di:waypoint x="178" y="120" /><di:waypoint x="285" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_d2_di" bpmnElement="Flow_d2"><di:waypoint x="395" y="120" /><di:waypoint x="465" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_d3_di" bpmnElement="Flow_d3"><di:waypoint x="575" y="120" /><di:waypoint x="645" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_d4_di" bpmnElement="Flow_d4"><di:waypoint x="755" y="120" /><di:waypoint x="862" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_d5_di" bpmnElement="Flow_d5"><di:waypoint x="718" y="270" /><di:waypoint x="825" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_d6_di" bpmnElement="Flow_d6"><di:waypoint x="935" y="270" /><di:waypoint x="1042" y="270" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
