<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_archiveorderprocess" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="ArchiveOrderProcess" name="Order archiving" isExecutable="true">
      <bpmn:startEvent id="StartArchive" name="Archiving started">
        <bpmn:outgoing>Flow_a1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="CollectDocuments" name="Collect the documents" camunda:type="external" camunda:topic="collectDocuments">
        <bpmn:incoming>Flow_a1</bpmn:incoming>
        <bpmn:outgoing>Flow_a2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="ArchiveDone" name="Archived">
        <bpmn:incoming>Flow_a2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_a1" sourceRef="StartArchive" targetRef="CollectDocuments" />
      <bpmn:sequenceFlow id="Flow_a2" sourceRef="CollectDocuments" targetRef="ArchiveDone" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="ArchiveOrderProcess">
      <bpmndi:BPMNShape id="StartArchive_di" bpmnElement="StartArchive"><dc:Bounds x="142" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="124" y="143" width="102" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CollectDocuments_di" bpmnElement="CollectDocuments"><dc:Bounds x="285" y="80" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ArchiveDone_di" bpmnElement="ArchiveDone"><dc:Bounds x="502" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="484" y="143" width="60" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_a1_di" bpmnElement="Flow_a1"><di:waypoint x="178" y="120" /><di:waypoint x="285" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_a2_di" bpmnElement="Flow_a2"><di:waypoint x="395" y="120" /><di:waypoint x="502" y="120" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
