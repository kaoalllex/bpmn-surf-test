<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_QesApplication" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="QesApplicationProcess" name="Periodic creation of a QES application" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Period started">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="UzIssuance" name="UZ Issuance">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:startEvent id="UzStart" name="Begin">
        <bpmn:outgoing>UzFlow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="IssueUz" name="Issue UZ">
        <bpmn:incoming>UzFlow_1</bpmn:incoming>
        <bpmn:outgoing>UzFlow_2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:subProcess id="SignUz" name="Sign UZ">
        <bpmn:incoming>UzFlow_2</bpmn:incoming>
        <bpmn:outgoing>UzFlow_3</bpmn:outgoing>
        <bpmn:userTask id="SignDocument" name="Sign document" />
        <bpmn:userTask id="VerifySignature" name="Verify signature" />
      </bpmn:subProcess>
      <bpmn:endEvent id="UzEnd" name="Issued">
        <bpmn:incoming>UzFlow_3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="UzFlow_1" sourceRef="UzStart" targetRef="IssueUz" />
      <bpmn:sequenceFlow id="UzFlow_2" sourceRef="IssueUz" targetRef="SignUz" />
      <bpmn:sequenceFlow id="UzFlow_3" sourceRef="SignUz" targetRef="UzEnd" />
    </bpmn:subProcess>
    <bpmn:subProcess id="CheckDocuments" name="Check documents">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:userTask id="CheckPassport" name="Check passport" />
    </bpmn:subProcess>
    <bpmn:subProcess id="ArchiveApplication" name="Archive application">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:userTask id="ArchiveScan" name="Archive scan" />
      <bpmn:userTask id="NotifyArchive" name="Notify archive" />
    </bpmn:subProcess>
    <bpmn:subProcess id="NotifyClient" name="Notify client">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:startEvent id="NotifyStart">
        <bpmn:outgoing>NotifyFlow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="SendEmail" name="Send e-mail">
        <bpmn:incoming>NotifyFlow_1</bpmn:incoming>
        <bpmn:outgoing>NotifyFlow_2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="NotifyEnd">
        <bpmn:incoming>NotifyFlow_2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="NotifyFlow_1" sourceRef="NotifyStart" targetRef="SendEmail" />
      <bpmn:sequenceFlow id="NotifyFlow_2" sourceRef="SendEmail" targetRef="NotifyEnd" />
    </bpmn:subProcess>
    <bpmn:endEvent id="EndEvent_1" name="Period closed">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="UzIssuance" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="UzIssuance" targetRef="CheckDocuments" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="CheckDocuments" targetRef="ArchiveApplication" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="ArchiveApplication" targetRef="NotifyClient" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="NotifyClient" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="QesApplicationProcess">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="100" y="240" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UzIssuance_di" bpmnElement="UzIssuance" isExpanded="true">
        <dc:Bounds x="180" y="150" width="520" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UzStart_di" bpmnElement="UzStart">
        <dc:Bounds x="210" y="240" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IssueUz_di" bpmnElement="IssueUz">
        <dc:Bounds x="290" y="218" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SignUz_di" bpmnElement="SignUz" isExpanded="false">
        <dc:Bounds x="440" y="218" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UzEnd_di" bpmnElement="UzEnd">
        <dc:Bounds x="610" y="240" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="UzFlow_1_di" bpmnElement="UzFlow_1">
        <di:waypoint x="246" y="258" />
        <di:waypoint x="290" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="UzFlow_2_di" bpmnElement="UzFlow_2">
        <di:waypoint x="390" y="258" />
        <di:waypoint x="440" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="UzFlow_3_di" bpmnElement="UzFlow_3">
        <di:waypoint x="540" y="258" />
        <di:waypoint x="610" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="CheckDocuments_di" bpmnElement="CheckDocuments" isExpanded="false">
        <dc:Bounds x="760" y="218" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ArchiveApplication_di" bpmnElement="ArchiveApplication" isExpanded="false">
        <dc:Bounds x="910" y="218" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NotifyClient_di" bpmnElement="NotifyClient" isExpanded="true">
        <dc:Bounds x="1060" y="150" width="320" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NotifyStart_di" bpmnElement="NotifyStart">
        <dc:Bounds x="1090" y="240" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendEmail_di" bpmnElement="SendEmail">
        <dc:Bounds x="1170" y="218" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NotifyEnd_di" bpmnElement="NotifyEnd">
        <dc:Bounds x="1320" y="240" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="NotifyFlow_1_di" bpmnElement="NotifyFlow_1">
        <di:waypoint x="1126" y="258" />
        <di:waypoint x="1170" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="NotifyFlow_2_di" bpmnElement="NotifyFlow_2">
        <di:waypoint x="1270" y="258" />
        <di:waypoint x="1320" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1440" y="240" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="136" y="258" />
        <di:waypoint x="180" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="700" y="258" />
        <di:waypoint x="760" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="860" y="258" />
        <di:waypoint x="910" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="1010" y="258" />
        <di:waypoint x="1060" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="1380" y="258" />
        <di:waypoint x="1440" y="258" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_SignUz">
    <bpmndi:BPMNPlane id="BPMNPlane_SignUz" bpmnElement="SignUz">
      <bpmndi:BPMNShape id="SignDocument_di" bpmnElement="SignDocument">
        <dc:Bounds x="160" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="VerifySignature_di" bpmnElement="VerifySignature">
        <dc:Bounds x="310" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_CheckDocuments">
    <bpmndi:BPMNPlane id="BPMNPlane_CheckDocuments" bpmnElement="CheckDocuments">
      <bpmndi:BPMNShape id="CheckPassport_di" bpmnElement="CheckPassport">
        <dc:Bounds x="160" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ArchiveApplication">
    <bpmndi:BPMNPlane id="BPMNPlane_ArchiveApplication" bpmnElement="ArchiveApplication">
      <bpmndi:BPMNShape id="ArchiveScan_di" bpmnElement="ArchiveScan">
        <dc:Bounds x="160" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NotifyArchive_di" bpmnElement="NotifyArchive">
        <dc:Bounds x="310" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
