        <inputEntry id="Rule_002_in4"><text></text></inputEntry>
        <inputEntry id="Rule_002_in5"><text>false</text></inputEntry>
        <outputEntry id="Rule_002_out0"><text>"LOCAL_COURIER_SAME_DAY_TWO_HOUR_SLOT"</text></outputEntry>
        <outputEntry id="Rule_002_out1"><text>72</text></outputEntry>
      </rule>
