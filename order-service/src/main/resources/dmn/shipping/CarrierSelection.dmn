        <outputEntry id="Rule_004_out0"><text>"UPS_STANDARD_SATURDAY_DELIVERY"</text></outputEntry>
        <outputEntry id="Rule_004_out1"><text>120</text></outputEntry>
      </rule>
      <rule id="Rule_005">
        <description>Standard delivery of a medium parcel to DE</description>
