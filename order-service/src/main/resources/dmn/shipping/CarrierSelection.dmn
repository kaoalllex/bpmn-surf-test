<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="CarrierSelection_defs" name="Carrier selection" namespace="http://camunda.org/schema/1.0/dmn">
  <decision id="CarrierSelection" name="Carrier selection for outbound parcels">
    <decisionTable id="CarrierSelection_table" hitPolicy="FIRST">
      <input id="Input_0" label="Destination country" camunda:inputVariable="country">
        <inputExpression id="InputExpression_0" typeRef="string"><text>country</text></inputExpression>
      </input>
      <input id="Input_1" label="Parcel size class" camunda:inputVariable="parcelSize">
        <inputExpression id="InputExpression_1" typeRef="string"><text>parcelSize</text></inputExpression>
      </input>
      <input id="Input_2" label="Gross weight, kg" camunda:inputVariable="weightKg">
        <inputExpression id="InputExpression_2" typeRef="double"><text>weightKg</text></inputExpression>
      </input>
      <input id="Input_3" label="Requested delivery speed" camunda:inputVariable="speed">
        <inputExpression id="InputExpression_3" typeRef="string"><text>speed</text></inputExpression>
      </input>
      <input id="Input_4" label="Customer tier and tags" camunda:inputVariable="customerTags">
        <inputExpression id="InputExpression_4" typeRef="string"><text>customerTags</text></inputExpression>
      </input>
      <input id="Input_5" label="Fragile or hazardous goods" camunda:inputVariable="fragile">
        <inputExpression id="InputExpression_5" typeRef="boolean"><text>fragile</text></inputExpression>
      </input>
      <output id="Output_0" label="Carrier and service" name="carrier" typeRef="string" />
      <output id="Output_1" label="Delivery SLA, hours" name="slaHours" typeRef="integer" />
      <rule id="Rule_000">
        <description>Standard delivery of a small parcel to DE</description>
        <inputEntry id="Rule_000_in0"><text>"DE"</text></inputEntry>
        <inputEntry id="Rule_000_in1"><text>"SMALL"</text></inputEntry>
        <inputEntry id="Rule_000_in2"><text>&lt;= 2</text></inputEntry>
        <inputEntry id="Rule_000_in3"><text>"STANDARD"</text></inputEntry>
        <inputEntry id="Rule_000_in4"><text>list contains(customerTags, "vip")</text></inputEntry>
        <inputEntry id="Rule_000_in5"><text></text></inputEntry>
        <outputEntry id="Rule_000_out0"><text>"DHL_EXPRESS_INTERNATIONAL_PRIORITY"</text></outputEntry>
        <outputEntry id="Rule_000_out1"><text>24</text></outputEntry>
      </rule>
      <rule id="Rule_001">
        <description>Express delivery of a small parcel to DE, fragile goods need a signature on delivery and a padded box</description>
        <inputEntry id="Rule_001_in0"><text>"DE"</text></inputEntry>
        <inputEntry id="Rule_001_in1"><text>"SMALL"</text></inputEntry>
        <inputEntry id="Rule_001_in2"><text>&lt;= 2</text></inputEntry>
        <inputEntry id="Rule_001_in3"><text>"EXPRESS"</text></inputEntry>
        <inputEntry id="Rule_001_in4"><text>list contains(customerTags, "b2b") and not(list contains(customerTags, "vip"))</text></inputEntry>
        <inputEntry id="Rule_001_in5"><text>true</text></inputEntry>
        <outputEntry id="Rule_001_out0"><text>"GLS_BUSINESS_PARCEL_FLEXDELIVERY"</text></outputEntry>
        <outputEntry id="Rule_001_out1"><text>48</text></outputEntry>
      </rule>
      <rule id="Rule_002">
        <description>Same_Day delivery of a small parcel to DE</description>
        <inputEntry id="Rule_002_in0"><text>"DE"</text></inputEntry>
        <inputEntry id="Rule_002_in1"><text>"SMALL"</text></inputEntry>
