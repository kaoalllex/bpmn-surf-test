        <outputEntry id="Rule_003_out0"><text>"DHL_EXPRESS_INTERNATIONAL_PRIORITY_INSURED"</text></outputEntry>
        <outputEntry id="Rule_003_out1"><text>12</text></outputEntry>
      </rule>
