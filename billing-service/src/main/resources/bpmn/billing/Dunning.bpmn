<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_dunningprocess" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:message id="Message_DunningResolved" name="DunningResolved" />
  <bpmn:process id="DunningProcess" name="Dunning" isExecutable="true">
    <bpmn:startEvent id="StartDunning" name="Dunning started">
      <bpmn:outgoing>Flow_dn1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Refund" name="Refund the payment" camunda:delegateExpression="${refundDelegate}">
      <bpmn:incoming>Flow_dn1</bpmn:incoming>
      <bpmn:outgoing>Flow_dn2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="AwaitResolution" name="Wait for the resolution" messageRef="Message_DunningResolved">
      <bpmn:incoming>Flow_dn2</bpmn:incoming>
      <bpmn:outgoing>Flow_dn3</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="WriteOff" name="Write off the debt" camunda:class="com.example.billing.delegate.WriteOffDelegate">
      <bpmn:incoming>Flow_dn3</bpmn:incoming>
      <bpmn:outgoing>Flow_dn4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="DunningDone" name="Dunning finished">
      <bpmn:incoming>Flow_dn4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_dn1" sourceRef="StartDunning" targetRef="Refund" />
    <bpmn:sequenceFlow id="Flow_dn2" sourceRef="Refund" targetRef="AwaitResolution" />
    <bpmn:sequenceFlow id="Flow_dn3" sourceRef="AwaitResolution" targetRef="WriteOff" />
    <bpmn:sequenceFlow id="Flow_dn4" sourceRef="WriteOff" targetRef="DunningDone" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="DunningProcess">
      <bpmndi:BPMNShape id="Refund_di" bpmnElement="Refund">
        <dc:Bounds x="285" y="80" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AwaitResolution_di" bpmnElement="AwaitResolution">
        <dc:Bounds x="465" y="80" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WriteOff_di" bpmnElement="WriteOff">
        <dc:Bounds x="645" y="80" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartDunning_di" bpmnElement="StartDunning">
        <dc:Bounds x="172" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="160" y="143" width="78" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DunningDone_di" bpmnElement="DunningDone">
        <dc:Bounds x="812" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="801" y="143" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_dn1_di" bpmnElement="Flow_dn1">
        <di:waypoint x="208" y="120" />
        <di:waypoint x="285" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_dn2_di" bpmnElement="Flow_dn2">
        <di:waypoint x="395" y="120" />
        <di:waypoint x="465" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_dn3_di" bpmnElement="Flow_dn3">
        <di:waypoint x="575" y="120" />
        <di:waypoint x="645" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_dn4_di" bpmnElement="Flow_dn4">
        <di:waypoint x="755" y="120" />
        <di:waypoint x="812" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
