<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_rootlevelprocess" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:message id="Message_RootOrderPaid" name="OrderPaid" />
  <bpmn:process id="RootLevelProcess" name="Root-level smoke diagram" isExecutable="true">
    <bpmn:startEvent id="StartRoot" name="Started">
      <bpmn:outgoing>Flow_root1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="RootValidate" name="Validate the order" camunda:type="external" camunda:topic="validateOrder">
      <bpmn:incoming>Flow_root1</bpmn:incoming>
      <bpmn:outgoing>Flow_root2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="RootFulfillment" name="Fulfillment" calledElement="FulfillmentProcess">
      <bpmn:incoming>Flow_root2</bpmn:incoming>
      <bpmn:outgoing>Flow_root3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:businessRuleTask id="RootRisk" name="Assess the payment risk" camunda:resultVariable="riskLevel" camunda:decisionRef="PaymentRiskMatrix" camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>Flow_root3</bpmn:incoming>
      <bpmn:outgoing>Flow_root4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:receiveTask id="RootAwait" name="Wait for the payment" messageRef="Message_RootOrderPaid">
      <bpmn:incoming>Flow_root4</bpmn:incoming>
      <bpmn:outgoing>Flow_root5</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="RootDone" name="Done">
      <bpmn:incoming>Flow_root5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_root1" sourceRef="StartRoot" targetRef="RootValidate" />
    <bpmn:sequenceFlow id="Flow_root2" sourceRef="RootValidate" targetRef="RootFulfillment" />
    <bpmn:sequenceFlow id="Flow_root3" sourceRef="RootFulfillment" targetRef="RootRisk" />
    <bpmn:sequenceFlow id="Flow_root4" sourceRef="RootRisk" targetRef="RootAwait" />
    <bpmn:sequenceFlow id="Flow_root5" sourceRef="RootAwait" targetRef="RootDone" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="RootLevelProcess">
      <bpmndi:BPMNShape id="RootValidate_di" bpmnElement="RootValidate">
        <dc:Bounds x="285" y="80" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RootFulfillment_di" bpmnElement="RootFulfillment">
        <dc:Bounds x="465" y="80" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RootRisk_di" bpmnElement="RootRisk">
        <dc:Bounds x="645" y="80" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RootAwait_di" bpmnElement="RootAwait">
        <dc:Bounds x="825" y="80" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartRoot_di" bpmnElement="StartRoot">
        <dc:Bounds x="192" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="186" y="143" width="36" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RootDone_di" bpmnElement="RootDone">
        <dc:Bounds x="992" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="991" y="143" width="27" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_root1_di" bpmnElement="Flow_root1">
        <di:waypoint x="228" y="120" />
        <di:waypoint x="285" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_root2_di" bpmnElement="Flow_root2">
        <di:waypoint x="395" y="120" />
        <di:waypoint x="465" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_root3_di" bpmnElement="Flow_root3">
        <di:waypoint x="575" y="120" />
        <di:waypoint x="645" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_root4_di" bpmnElement="Flow_root4">
        <di:waypoint x="755" y="120" />
        <di:waypoint x="825" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_root5_di" bpmnElement="Flow_root5">
        <di:waypoint x="935" y="120" />
        <di:waypoint x="992" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
